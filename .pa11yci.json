{
  "defaults": {
    "runners": ["axe"],
    "standard": "WCAG2AA",
    "timeout": 30000,
    "wait": 2000,
    "chromeLaunchConfig": {
      "args": ["--no-sandbox", "--disable-setuid-sandbox", "--disable-dev-shm-usage"]
    },
    "threshold": 25
  },
  "urls": [
    "http://localhost:8000/",
    "http://localhost:8000/login/",
    "http://localhost:8000/help/",
    "http://localhost:8000/privacy/",
    "http://localhost:8000/eula/",
    { "url": "http://localhost:8000/dashboard/", "authenticated": true },
    { "url": "http://localhost:8000/myorganisation/", "authenticated": true },
    { "url": "http://localhost:8000/profile/", "authenticated": true }
  ]
}
